# HearMeOut: copy to .env (git-ignored). ONE file, read by the API, the web app and scripts.
# In production the same names go into Render (API) and Vercel (web) dashboards.

# --- Runtime ---
ENVIRONMENT=development
APP_SECRET=
INTERNAL_API_SECRET=
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:8000

# --- Web <-> API URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# --- Database + storage (Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
STORAGE_BACKEND=supabase
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=audio

# --- Auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
ADMIN_USER_IDS=

# --- LLM (Groq, optional) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OCR for scanned PDFs (needs the ocr extra; set false on very small hosts) ---
OCR_ENABLED=true

# --- Payments (Dodo, optional until you sell) ---
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_BOOK=

# --- Analytics + site (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
